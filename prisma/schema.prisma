// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. PENGGUNA (Kasir & Admin)
// ==========================================
enum Role {
  ADMIN
  CASHIER
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String   // Harus di-hash
  role      Role     @default(CASHIER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
}

// ==========================================
// 2. PRODUK & KATEGORI
// ==========================================
model Category {
  id        String    @id @default(cuid())
  name      String
  desc      String?
  color     String?
  icon      String?
  products  Product[]
}

model Product {
  id          String   @id @default(cuid())
  sku         String?  @unique // Barcode (opsional)
  name        String
  description String?
  costPrice   Decimal  @db.Decimal(10, 2) // Harga Beli/Modal
  sellPrice   Decimal  @db.Decimal(10, 2) // Harga Jual
  stock       Int      @default(0)
  categoryId  String?
  imageUrl    String?
  isProcessed Boolean  @default(false)
  recipe      Json?    // Array of { productId, quantity }
  category    Category? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactionItems TransactionItem[]
  stockMovements   StockMovement[]
}

// ==========================================
// 3. TRANSAKSI (KASIR)
// ==========================================
enum PaymentMethod {
  CASH
  QRIS
  DEBT // Transaksi Kasbon (Ngutang)
}

model Transaction {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique // Misal: INV-20231025-001
  totalAmount   Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  userId        String        // Kasir yang melayani
  user          User          @relation(fields: [userId], references: [id])
  customerId    String?       // Wajib diisi jika Kasbon
  customer      Customer?     @relation(fields: [customerId], references: [id])
  shiftId       String?       // Shift transaksi terjadi
  shift         Shift?        @relation(fields: [shiftId], references: [id])
  createdAt     DateTime      @default(now())

  items TransactionItem[]
  debt  Debt?
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  quantity      Int
  price         Decimal     @db.Decimal(10, 2) // Rekam harga jual SAAT transaksi terjadi
  subtotal      Decimal     @db.Decimal(10, 2) // quantity * price
}

// ==========================================
// 4. PELANGGAN & KASBON (Hutang)
// ==========================================
model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  debts        Debt[]
}

model Debt {
  id            String      @id @default(cuid())
  transactionId String      @unique // Terhubung ke struk transaksi pembelian
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  amount        Decimal     @db.Decimal(10, 2) // Total hutang awal
  remaining     Decimal     @db.Decimal(10, 2) // Sisa hutang yang belum dibayar
  dueDate       DateTime?   // Tanggal jatuh tempo (opsional)
  isPaid        Boolean     @default(false)    // Lunas atau belum
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  payments DebtPayment[]
}

model DebtPayment {
  id          String   @id @default(cuid())
  debtId      String
  debt        Debt     @relation(fields: [debtId], references: [id])
  amount      Decimal  @db.Decimal(10, 2) // Jumlah yang dicicil/dibayar
  paymentDate DateTime @default(now())
}

// ==========================================
// 5. INVENTORI (Pergerakan Stok)
// ==========================================
enum MovementType {
  IN      // Tambah stok (Kulakan)
  OUT     // Kurang stok (Rusak / Expired / Konsumsi sendiri)
  ADJUST  // Penyesuaian stok saat opname
}

model StockMovement {
  id          String       @id @default(cuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  type        MovementType
  quantity    Int          // Jumlah barang yang masuk/keluar
  description String?      // Keterangan (Misal: "Beli di Indogrosir", "Dimakan tikus")
  createdAt   DateTime     @default(now())
}

// ==========================================
// 6. SHIFT KASIR (Pertanggungjawaban Kas)
// ==========================================
model Shift {
  id           String        @id @default(cuid())
  cashierName  String
  openTime     String
  closeTime    String?
  initialCash  Decimal       @db.Decimal(10, 2)
  cashSales    Decimal       @db.Decimal(10, 2) @default(0)
  nonCashSales Decimal       @db.Decimal(10, 2) @default(0)
  debtSales    Decimal       @db.Decimal(10, 2) @default(0)
  expectedCash Decimal       @db.Decimal(10, 2) @default(0)
  actualCash   Decimal?      @db.Decimal(10, 2)
  discrepancy  Decimal       @db.Decimal(10, 2) @default(0)
  status       String        // "OPEN" | "CLOSED"
  createdAt    DateTime      @default(now())
  
  transactions Transaction[]
}

// ==========================================
// 7. BEBAN OPERASIONAL (Expenses)
// ==========================================
model Expense {
  id        String   @id @default(cuid())
  date      String   // Format YYYY-MM-DD
  category  String   // Misal: "Operasional", "Listrik", "Gaji", dll.
  amount    Decimal  @db.Decimal(10, 2)
  notes     String?
  createdAt DateTime @default(now())
}
